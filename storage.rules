rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdminUid() {
      return signedIn() && request.auth.uid in [
        '9Joz8XEbqiSk2AzSWDzvikfQfEk1'
      ];
    }

    function userDocExists() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isBootstrapAdminUid() || (userDocExists() && currentUser().role == 'admin');
    }

    function isInstructor() {
      return userDocExists() && currentUser().role == 'instructor';
    }

    function isCompany() {
      return userDocExists() && currentUser().role == 'company';
    }

    function currentCompanyTag() {
      return userDocExists() ? currentUser().companyTag : '';
    }

    function personaDocExists(personaId) {
      return firestore.exists(/databases/(default)/documents/personas/$(personaId));
    }

    function personaCompanyTag(personaId) {
      return personaDocExists(personaId)
        ? firestore.get(/databases/(default)/documents/personas/$(personaId)).data.companyTag
        : '';
    }

    function companyMatchesPersona(personaId) {
      return isCompany() && personaDocExists(personaId) && personaCompanyTag(personaId) == currentCompanyTag();
    }

    function isPdfUpload() {
      return request.resource != null && request.resource.contentType == 'application/pdf';
    }

    match /personas/{personaId}/archivos/{fileName} {
      allow read: if isAdmin() || isInstructor() || companyMatchesPersona(personaId);
      allow create, update: if (isAdmin() || isInstructor()) && isPdfUpload();
      allow delete: if isAdmin() || isInstructor();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
